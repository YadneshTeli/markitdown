{
  "name": "markitdown",
  "version": "0.1.0",
  "description": "Utility tool for converting various files to Markdown — TypeScript port",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "markitdown": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "markdown",
    "converter",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "html",
    "llm",
    "markitdown"
  ],
  "author": "Yadnesh Teli",
  "license": "MIT",
  "dependencies": {
    "chardet": "^2.0.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "exifreader": "^4.23.0",
    "fast-xml-parser": "^4.5.0",
    "file-type": "^19.6.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "mime-types": "^2.1.35",
    "music-metadata": "^10.6.1",
    "pdf-parse": "^1.1.1",
    "turndown": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/turndown": "^5.0.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
